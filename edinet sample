import requests
import zipfile
import io

# トヨタ自動車（E01735）の例
edinet_code = "E01735"

# 1. 提出書類一覧の取得（提出日指定）
url = "https://disclosure.edinet-fsa.go.jp/api/v2/documents.json"
params = {
    "date": "2024-06-30",   # 提出日（例）
    "type": 2               # 2 = 有価証券報告書など
}
res = requests.get(url, params=params)
data = res.json()

# 2. トヨタの報告書を探す
for doc in data["results"]:
    if doc["edinetCode"] == edinet_code:
        doc_id = doc["docID"]
        print("Found:", doc_id)
        break

# 3. ZIP形式で報告書をダウンロード
url_doc = f"https://disclosure.edinet-fsa.go.jp/api/v2/documents/{doc_id}?type=1"
res = requests.get(url_doc)
with zipfile.ZipFile(io.BytesIO(res.content)) as z:
    z.extractall("toyota_report")

print("✅ トヨタの報告書をダウンロードしました！")

